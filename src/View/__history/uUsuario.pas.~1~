unit uUsuario;

interface

uses
  System.SysUtils, System.Classes, Vcl.Forms, Vcl.StdCtrls, Vcl.Controls,
  Vcl.Dialogs, uUsuarioController, uUsuarioModel;

type
  TfrmUsuario = class(TForm)
    lblNome: TLabel;
    lblEmail: TLabel;
    lblSenha: TLabel;
    edtNome: TEdit;
    edtEmail: TEdit;
    edtSenha: TEdit;
    btnSalvar: TButton;
    btnCancelar: TButton;
    procedure btnSalvarClick(Sender: TObject);
  private
    FController: TUsuarioController;
    FId: Integer;
    FEdicao: Boolean;
  public
    class function Executar(AOwner: TComponent; AController: TUsuarioController; AId: Integer = 0): Boolean;
  end;

implementation

{$R *.dfm}

class function TfrmUsuario.Executar(AOwner: TComponent; AController: TUsuarioController; AId: Integer): Boolean;
var F: TfrmUsuario; U: TUsuario;
begin
  F := TfrmUsuario.Create(AOwner);
  try
    F.FController := AController;
    F.FId := AId;
    F.FEdicao := AId > 0;

    if F.FEdicao then
    begin
      F.Caption := 'Editar usuário';
      F.lblSenha.Caption := 'Nova senha';
      U := AController.GetById(AId);
      try
        if Assigned(U) then
        begin
          F.edtNome.Text := U.Nome;
          F.edtEmail.Text := U.Email;
        end;
      finally
        U.Free;
      end;
    end
    else
      F.Caption := 'Novo usuário';

    Result := F.ShowModal = mrOk;
  finally
    F.Free;
  end;
end;

procedure TfrmUsuario.btnSalvarClick(Sender: TObject);
begin
  try
    if FEdicao then
      FController.Atualizar(FId, edtNome.Text, edtEmail.Text, edtSenha.Text)
    else
      FController.Cadastrar(edtNome.Text, edtEmail.Text, edtSenha.Text);
    ModalResult := mrOk;
  except
    on E: Exception do
      MessageDlg(E.Message, mtError, [mbOK], 0);
  end;
end;

end.
